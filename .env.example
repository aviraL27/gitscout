# GitHub Personal Access Token
# Create at: https://github.com/settings/tokens
# Required scopes: read:user, public_repo
GITHUB_TOKEN=

# Gemini API Key (Gemma fallback when Ollama is unavailable)
GEMINI_API_KEY=

# Ollama local endpoint (primary — Gemma 4 via Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b

# API server port
PORT=3001

# Gmail SMTP for automated outbound outreach (500 emails/day free)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
